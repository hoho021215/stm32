/*
 * [참고용] CubeMX 생성 main.c에서 수정 위치를 보여 주는 부분 예제입니다.
 * 이 파일을 main.c에 통째로 덮어쓰거나 빌드에 추가하지 마세요.
 * 생성된 원본 파일의 같은 USER CODE 구역 안에 [직접 추가] 내용만 넣습니다.
 * SystemClock_Config(), MX_*_Init() 정의와 생성된 주변장치 헤더는 생략했습니다.
 * 첨부 ex1.ioc에는 아직 아래 DMA/ADC 초기화 호출이 모두 준비되지 않았습니다.
 * ADC/TIM 설정을 확정하고 Generate Code한 뒤 생성된 호출을 기준으로 적용합니다.
 */

#include "main.h" /* [CubeMX 자동 생성] 기존 include 유지 */
/* adc.h, dma.h, tim.h, gpio.h 등 생성된 include가 있으면 그대로 유지 */

/* USER CODE BEGIN Includes */
#include "buck_app.h" /* [직접 추가] 사용자 벅 제어 모듈 선언 */
/* USER CODE END Includes */

int main(void)
{
  /* USER CODE BEGIN 1 */
  /* [직접 추가 없음] 이 위치에서는 아직 주변장치 초기화 전입니다. */
  /* USER CODE END 1 */

  HAL_Init();             /* [CubeMX 자동 생성] 유지 */
  SystemClock_Config();   /* [CubeMX 자동 생성] .ioc에서 클럭 설정 */

  /* [CubeMX 자동 생성] 실제 프로젝트가 만든 초기화 호출을 유지합니다.
   * DMA 초기화는 ADC 초기화보다 먼저 실행되도록 .ioc에서 순서를 확인합니다. */
  MX_GPIO_Init();
  MX_DMA_Init();
  MX_ADC1_Init();
  MX_TIM1_Init();

  /* USER CODE BEGIN 2 */
  /* [직접 추가] GPIO/DMA/ADC1/TIM1 초기화가 모두 끝난 후 한 번 호출합니다.
   * 이 함수가 ADC 영점 보정과 안전한 기동 순서를 관리합니다.
   * HAL_TIM_PWM_Start(), HAL_TIMEx_PWMN_Start()를 따로 추가하지 마세요. */
  Buck_Init();
  /* USER CODE END 2 */

  /* Infinite loop */
  /* USER CODE BEGIN WHILE */
  while (1)
  {
    /* USER CODE END WHILE */

    /* USER CODE BEGIN 3 */
    /* [직접 추가] ADC 갱신 정지 감시. 장시간 대기 코드를 추가하지 마세요. */
    Buck_Poll();
  }
  /* USER CODE END 3 */
}

/* [CubeMX 자동 생성] SystemClock_Config()와 MX_*_Init()의 원래 정의 유지.
 * 이 참고 파일에는 생성 함수 전체를 싣지 않았습니다. */

/* USER CODE BEGIN 4 */
/* [직접 추가 없음] ADC 콜백은 Core/Src/buck_app.c에 이미 구현되어 있습니다.
 * 이 구역에 같은 HAL_ADC_*Callback 함수를 다시 만들면 중복 정의됩니다. */
/* USER CODE END 4 */

void Error_Handler(void)
{
  /* USER CODE BEGIN Error_Handler_Debug */
  __disable_irq(); /* [기존 코드 유지] ADC ISR의 재진입부터 차단 */
  /* [직접 추가] 인터럽트를 끈 뒤, 기존 정지 루프 앞에서 게이트를 차단 */
  Buck_EmergencyOff();
  while (1)
  {
  }
  /* USER CODE END Error_Handler_Debug */
}
